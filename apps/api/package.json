{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "dotenv run -q -f ../../.env -- nest start",
    "dev": "dotenv run -q -f ../../.env -- nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv run -q -f ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv run -q -f ../../.env -- prisma migrate deploy",
    "db:test": "dotenv run -q -f ../../.env -- sh -c 'DATABASE_URL=$TEST_DATABASE_URL prisma migrate deploy'",
    "db:seed": "dotenv run -q -f ../../.env -- prisma db seed"
  },
  "dependencies": {
    "@fernleaf/shared": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "luxon": "^3.7.2",
    "nestjs-zod": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "dotenv-cli": "^11.0.0",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.9.0"
  }
}
